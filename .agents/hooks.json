{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python scripts/sdd_immutable_feature_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run python scripts/sdd_code_gate_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
